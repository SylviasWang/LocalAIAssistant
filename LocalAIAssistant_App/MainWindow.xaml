<Window x:Class="LocalAIAssistant_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalAIAssistant_App"
        mc:Ignorable="d"
        Title="LocalAI Assistant" Height="450" Width="800">
    <Grid Margin ="2,5,2,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ListMsg" Grid.Row="0" ItemsSource="{Binding Messages}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Role}" />
                        <TextBlock Text=" : " />
                        <TextBlock Text="{Binding Content}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Margin ="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtContent" Grid.Column="0" Margin ="0,0,2,0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <Button x:Name="BtnEnter" Content="Send" Padding="5,0,5,0"  Grid.Column="1" Command="{Binding SendCommand}"></Button>
            <Button x:Name="BtnCancel" Content="Cancel" Padding="5,0,5,0"  Grid.Column="2" Command="{Binding SendCancelCommand}"></Button>
        </Grid>
    </Grid>
</Window>
